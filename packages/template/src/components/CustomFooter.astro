---
import Default from '@astrojs/starlight/components/Footer.astro';

// The credit is EkLine's hosted web component rather than markup written here,
// so its wording and mark follow EkLine's current credit without an edit to
// this file. See https://docs.ekline.io/credit/.
---

<Default><slot /></Default>

<div class="ekline-credit-wrapper">
	<ekline-credit></ekline-credit>
</div>

<script is:inline src="https://ekline.io/v1/credit.js" async></script>

<style>
	.ekline-credit-wrapper {
		margin-top: 2.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--sl-color-gray-5);
		/* `gray-3`, at full opacity, for legibility.
		 *
		 * This credit was `gray-4` at 85% opacity, which measured 2.63:1 in light
		 * and 2.35:1 in dark — well under the 4.5:1 WCAG AA minimum for text this
		 * small, and it appears on every page of the site. Stacking a
		 * partial opacity on an already-muted grey is what pushed it under; the
		 * credit still reads as secondary without it. */
		color: var(--sl-color-gray-3);
	}

	/* The hosted component dims itself to 85%, which is the stacking described
	 * above. Its `credit` part is the supported way to undo that from outside
	 * its shadow root. */
	ekline-credit::part(credit) {
		opacity: 1;
	}
</style>
